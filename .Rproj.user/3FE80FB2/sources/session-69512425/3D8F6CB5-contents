#need to wrap this thing in a for loop that loops through all fires in a directory

files <- list.files(path="Data", pattern="*.nc", full.names=FALSE, recursive=FALSE)

#files will be named

#blahdatetime ex: data20200818_12

#need an output directory for each day? Because we will be

#files will be organized

for(file in files)
{
  fnam = paste("Data/", file, sep = "")
  print(fnam)
  #remove this break statement when we are ready to actually process the data
  break()
  ncin<- nc_open(fnam)
  
  depths <- ncvar_get(ncin, "depth")
  
  lon<- ncvar_get(ncin, "lon")
  
  lat <- ncvar_get(ncin, "lat")
  
  #create a folder of the file name
  
  folder_name <- tools::file_path_sans_ext(fnam)
  
  dir.create(folder_name, recursive = TRUE, showWarnings = FALSE)
  
  out_dir<- file.path(folder_name)
  
  #loop through the raster file and parse it into individual depths. 
  
  for(i in 1:length(depths))
    
  {
    
    print(i)
    
    temp_i<- ncvar_get(ncin, "water_temp", start = c(1,1,i,1), count = c(-1,-1,1,1))
    
    
    r_temp <- rast(t(temp_i), extent = c(min(lon), max(lon), min(lat), max(lat)))
    
    crs(r_temp) <- "EPSG:4326"
    
    #plot(r_temp, main = paste("temp at depth", depths[i], sep = " "))
    
    name<- paste("temp_at_depth", depths[i], sep = "_")
    
    writeRaster(r_temp, filename = file.path(out_dir, paste0(name, ".tif")),
                overwrite = TRUE)
    
  }
  
  #need to figure out how to properly close the netcdf files. 
  ncout<- nc_close(ncin)
  rm(ncout)
  gc()
  
  
}

