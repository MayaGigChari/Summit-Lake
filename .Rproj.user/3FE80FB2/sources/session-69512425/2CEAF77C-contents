library(recapr)

obj_fun <- function(n_1, n_2, e_1, e_2){
  return(n_1*e_1+n_2*e_2)
}
# Main routine
e_1 <- 1/0.44
e_2 <- 1/0.31
conf <- 0.9
acc <- 0.25
n_vec <- c(500, 1000, 1500, 2000, 2500)
results <- matrix(NA, nrow=length(n_vec), ncol=3)
for (j in 1:length(n_vec)){
  N <- n_vec[j]
  mat <- matrix(NA, nrow=N, ncol=3)
  for (n_1 in 1:N){
    n_2 <- n2RR(N, n_1, conf=conf, acc=acc)[[1]][1,2] # Robson and Regier using Tyers (2019)
    mat[n_1,] <- c(n_1, n_2, obj_fun(n_1, n_2, e_1, e_2))
  }
  results[j, 1] <- N
  results[j, 2:3] <- mat[mat[,3]==min(mat[,3]),][1:2]
}
