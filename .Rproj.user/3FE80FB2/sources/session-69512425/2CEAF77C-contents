  # Step 4: Simulate catch data (Poisson distributed)
  catches <- rpois(num_sets, lambda = gamma)  
  
  # Step 5: Estimate CPUE from simulated catch data
  estimated_cpue <- mean(catches)
  
  # Step 6: Check if estimated CPUE is within 30% of true value
  within_30_percent[sim] <- (estimated_cpue >= 0.8 * true_mu) & (estimated_cpue <= 1.2 * true_mu)
