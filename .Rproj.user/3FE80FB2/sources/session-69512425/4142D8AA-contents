  scale_size(range = c(1, 10)) +  # Adjust min/max dot sizes
  theme_minimal() +
  theme(
    axis.text=element_text(size=8),
    axis.title=element_text(size=8,face="bold"),
    axis.text.x = element_text(angle = 45, hjust=1)
  )+
  
  labs(size = "Burbot Caught", title = "Birch Lake Catch by Trap Both Events")

ggsave("burbot_catch_nums_both_events_paneled.png", dpi = 300)

#make a depth profile

#here there is one datapoint per depth bin. 
depth_data<- 
  data.frame(burbot_data_with_geog)%>%
  group_by(depth_m, event)%>%
  summarize(
    avg_catch = sum(fish_trap)/n()
  )%>%
  arrange(depth_m)

#plotting catch by depth
ggplot(depth_data,aes(x=depth_m,y=avg_catch, color = as.factor(event)))+
  facet_grid(~event)+
  labs(color = "event", x = "depth (m)", y = "average catch")+
  #set up the asthetics, the line must be broken because this is technically discrete data
  geom_point()

#l#l#looks like there's not a strong depth profile for these fish. 
#maybe a little bit higher density at a lower depth. 
#for each depth we get an average number of fish caught (total traps at that density/total number of fish caught. )


#another way to plot average catch by depth per event. 
ggplot(depth_data, aes(x = depth_m, y = avg_catch, fill = as.factor(event)))+
  facet_wrap(~event)+
  labs(x = "depth (m)", y = "average catch", fill = "event")+
  geom_bar(stat = "identity")


library(dplyr)

data_binned_depth <- burbot_rawdata %>%
  drop_na(depth_m)%>%
  mutate(depth_bin = cut(depth_m, breaks = seq(min(depth_m), max(depth_m+5), by = 2))) %>%
  group_by(depth_bin, event) %>%
  summarise(
    avg_catch = mean(fish_trap, na.rm = TRUE),
    se_catch = sd(fish_trap, na.rm = TRUE) / sqrt(n()),
    avg_length = mean(fish_tl_mm, na.rm = TRUE),
    se_length = sd(fish_tl_mm, na.rm = TRUE) / sqrt(n())
  )%>%
  drop_na()

ggplot(data_binned_depth, aes(x = depth_bin, y = avg_catch, fill = as.factor(event))) +
  facet_grid(~event)+
  geom_col()+
  geom_errorbar(aes(ymin = avg_catch - se_catch, ymax = avg_catch + se_catch), width = 0.2) +
  labs(x = "Depth Bin (m)", y = "Average Catch per Trap", title = "Average Catch by Depth Bin", fill = "event") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

#we don't see much interesting here. Let's try a violin plot

full_data_binned_depth <- burbot_rawdata %>%
  drop_na(depth_m)%>%
  mutate(depth_bin = cut(depth_m, breaks = seq(0, ceiling(max(depth_m)+5), by = 2)))%>%
  drop_na(depth_bin)

# Step 2: Plot violin plot
ggplot(
  full_data_binned_depth, aes(x = depth_bin, y = fish_trap, fill = as.factor(event))) +
  geom_violin(color = "darkblue", scale = "width", trim = FALSE) +
  geom_jitter(width = 0.2, alpha = 0.4, size = 1, color = "black")+
  facet_grid(~event)+
  stat_summary(fun = median, geom = "point", shape = 21, fill = "white", size = 2) +
  labs(x = "Depth Bin (m)", y = "Catch", title = "Catch Distribution by Depth Bin", fill = "event") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))


#there is a visualization with depth of the catch. 

#we could also probably do the same thing with depth and length
ggplot(data_binned_depth, aes(x = depth_bin, y = avg_length, fill = as.factor(event))) +
  geom_col() +
  facet_grid(~event)+
  geom_errorbar(aes(ymin = avg_length-se_length, ymax = avg_length+se_length), width = 0.2) +
  labs(x = "Depth Bin (m)", y = "Average Length", title = "Averagee Length by Depth Bin", fill = "event") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

#here it looks like the shallower depths have less even spread, but also have more data. 
ggplot(
  full_data_binned_depth, aes(x = depth_bin, y = fish_tl_mm), fill = as.factor(event))+
  geom_violin(color = "darkblue", scale = "width", trim = FALSE) +
  facet_grid(~event)+
  geom_jitter(width = 0.2, alpha = 0.4, size = 1, color = "black")+
  stat_summary(fun = median, geom = "point", shape = 21, fill = "white", size = 2) +
  labs(x = "Depth Bin (m)", y = "Length (mm FL)", title = "Length Distribution by Depth") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

