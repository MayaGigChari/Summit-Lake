```{r}
burbot_rawdata<- read_excel("Birch_raw_data_master_10_13_2025.xlsx", sheet = "Master")
burbot_rawdata<- clean_names(burbot_rawdata)
burbot_cleaned_data_event1<-burbot_rawdata%>%
  filter(event ==1)

burbot_cleaned_data_event2<- burbot_rawdata%>%
  filter(event ==2)

transect_geog<-read_excel("Birch_raw_data_master_10_13_2025.xlsx", sheet = "Coordinates")
transect_geog_cleaned<- clean_names(transect_geog)
#this has the soak time included, which I computed using excel. 


#first we will visualize the raw data. 

birch_shape <- st_read("birch_gis")
birch_s2<- st_as_s2(birch_shape)
birch_s2<- st_as_sf(birch_s2)
conv_nor <- concaveman(birch_s2)

plot(conv_nor$polygons)
#I guess this already had geographic information anyways

#there might be some mis-alignment with the geography in the original data and the true geography of the transect-trap combos. 

burbot_data_with_geog_event1<- left_join(burbot_cleaned_data_event1, transect_geog_cleaned, by = c("trap_number", "transect_number"="transect"))
burbot_data_with_geog_event1<- st_as_sf(burbot_data_with_geog_event1, coords = c("x", "y"), crs = "WGS84" )


burbot_data_with_geog_event2<- left_join(burbot_cleaned_data_event2, transect_geog_cleaned, by = c("trap_number", "transect_number"="transect"))
burbot_data_with_geog_event2<- st_as_sf(burbot_data_with_geog_event2, coords = c("x", "y"), crs = "WGS84" )


full_burbot_data_with_geog<- left_join(burbot_rawdata, transect_geog_cleaned, by = c("trap_number", "transect_number"="transect"))
burbot_data_with_geog<- st_as_sf(full_burbot_data_with_geog, coords = c("x", "y"), crs = "WGS84" )
```

```{r}



ggplot(data = conv_nor) +
  geom_sf()+
  geom_sf(data = burbot_data_with_geog, aes(size = fish_trap), color = "blue", alpha = 0.2) +
