#this remains the same as the original code. 
get.geo.dist = function(long1, lat1, long2, lat2, units = "m") {
  print(c(long1, lat1, long2, lat2))
  longlat1 = purrr::map2(long1, lat1, function(x,y) c(x,y))
  longlat2 = purrr::map2(long2, lat2, function(x,y) c(x,y))
  distance_list = purrr::map2(longlat1, longlat2, function(x,y) geosphere::distHaversine(x, y))
  distance_m = list.extract(distance_list, position = 1)
  if (units == "km") {
    distance = distance_m / 1000.0;
  }
  else if (units == "miles") {
    distance = distance_m / 1609.344
  }
  else {
    distance = distance_m
  }
  return(distance)
}



#modified pick.coords function using the sf package and also sampling the entire lake (n_sets not required)
pick.coords <- function(lakelines, n_sets, seed = 123, quiet = T) {
  set.seed(seed)
  bbox <- st_bbox(lakelines)
  x_min <- bbox[1]
  x_max <- bbox[3]
  y_min <- bbox[2]
  y_max <- bbox[4]
  
  # Calculate number of grid points in the x and y directions that cover the lake. Basically make the grid
  n_x <- floor(get.geo.dist(x_min, y_min, x_max, y_min) / 125)
  n_y <- get.geo.dist(x_min, y_min, x_min, y_max) / 125 # ~95
  
  print(c(n_x, n_y))
  
  possible_x <- seq(x_min, x_max, length = n_x)
  possible_y <- seq(y_min, y_max, length = n_y)
  
  points <- expand.grid(x = possible_x, y = possible_y)
  
  points_sf <- st_as_sf(points, coords = c("x", "y"), crs = st_crs(lakelines))

  points_within <- st_intersection(points_sf, lakelines)
  
  # Extract the points that are within the lakelines (polygon)
  
  #sets <- points[apply(points_within, 1, any),]
  p<-ggplot()+
    geom_sf(data = lakelines) + 
    geom_sf(data = points_within)
  print(p)
  # Generate a table of y-values (transects) for the selected sets
  tt <- table(st_coordinates(points_within)[, 2]) # Extracts y-values
  
  print(tt)
  
  # Create presence-absence matrix
  max_tt <- max(tt)
  ts_mat <- matrix(FALSE, nrow = max_tt, ncol = length(tt))
  
  for (i in seq_along(tt)) {
    ts_mat[1:tt[i], i] <- TRUE
  }
  
  # Output a structured list
  return(list(ts_mat = ts_mat, table = tt, set_coords = points_within))
}

#this is all based on the estimate of CPUE
#can iterate over several values of N.
#here q, or "catchability" is essentially how good the "effort" (ie traps) actually are at catching the fish. 
#make the assumption that cpue is proportional to N*q/area = total numbers*catchability/maximum area that can be fished.  
#the true estimate of CPUE assumes total effort. This study also employs total effort. 


#we can also assess average cpue by the number of samples/number of traps? 

assess.accuracy <- function(ts_mat, N_vec, sig_vec, q_bar, sd_q, acc_lev, A, n_mc=1000){
  #get the number of columns in the matrix
  n <- ncol(ts_mat)
  #gets the average SETS in a transect (= mbar?)
  m_bar <- mean(apply(ts_mat, MARGIN = 2, sum))
  print(m_bar)
  #creates an empty matrix
  ret_mat_CPUE <- matrix(NA, length(N_vec), length(sig_vec))
  for(i in 1:length(N_vec)){
    N <- N_vec[i]
    #sample the value of "catchability" from the distribution of q. 
    #maybe I can use some other Burbot paper for this. 
    q <- rnorm(1, q_bar, sd_q) # Check sd(q)
    print("q")
    print(q)
    
    #this is the average CPUE given some area and some value of q and the estimated N
    mu <- N/A*q
    #because q is relatively low, we generate a CPUE average much lower than the true probably hopefully
    print("mu")
    print(mu)
    for(j in 1:length(sig_vec)){
      #get the sigma value
      sig <- sig_vec[j]
      c_mat <- matrix(NA, nrow(ts_mat), ncol(ts_mat))
      #build an empty matrix 
      l_1 <- 0
      #populate the matrix with artificial catch data for each set (how we measure CPUE in the field given our limited "E")
      for (k in 1:n_mc){
        for(t in 1:ncol(c_mat)){
          ep <- rnorm(1, 0, sig)
          gam <- mu/exp(.5*sig^2)*exp(ep)
          for(s in 1:nrow(ts_mat)){
            if (ts_mat[s, t]){
              #draw values for each element of the matrix. 
              c_mat[s,t] <- rpois(1, gam)
            }
          }
        }
        #calculate the estimated average CPUE based on the equation in the OP plan
        cpue_est <- 1/(n*m_bar)*sum(c_mat, na.rm=T)
        
        #determine the accuracy 
        acc <- abs(mu-cpue_est)/mu
        if (acc < acc_lev[1]){
          l_1 <- l_1+1
        }
      }
      ret_mat_CPUE[i,j] <- l_1/n_mc
    }
  }
  rownames(ret_mat_CPUE) <- as.character(N_vec)
  colnames(ret_mat_CPUE) <- as.character(sig_vec)
  return(ret_mat_CPUE)
}



