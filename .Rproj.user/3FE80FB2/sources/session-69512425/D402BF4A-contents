#twice modified function to account for multiple N values
#lots of this is originally Matt Tyers code. 
n2RR_plot_multi_N <- function(N_values, 
                              conf = c(0.99, 0.95, 0.9, 0.85, 0.8, 0.75),
                              acc = c(0.5, 0.25, 0.2, 0.15, 0.1, 0.05, 0.01)) {
  
  accall <- c(0.5, 0.25, 0.2, 0.15, 0.1, 0.05, 0.01)
  
  # Validate user input
  conf <- conf[conf %in% c(0.99, 0.95, 0.9, 0.85, 0.8, 0.75)]
  acc <- acc[acc %in% accall]
  
  # Sort accuracy for consistency
  acc <- sort(acc, decreasing = TRUE)
  results <- data.frame()
  for (N in N_values) {
    for (i in 1:length(conf)) {
      # Precomputed critical values for each confidence level
      Draw <- (conf[i] == 0.99) * c(48.707, 135.529229, 196.2951017, 325.8179089, 
                                    694.4679116, 2684.858928, 66380.75202) +
        (conf[i] == 0.95) * c(24.35001031, 69.83385388, 103.9898307, 178.3155987, 
                              391.4504252, 1543.721381, 38421.81) +
        (conf[i] == 0.9) * c(14.7893, 45.79545303, 69.92066847, 122.361479, 
                             272.5531006, 1084.149431, 27057.47792) +
        (conf[i] == 0.85) * c(9.74015, 33.5685, 52.11740329, 92.33768116, 
                              207.4134585, 829.0626252, 20722.71022) +
        (conf[i] == 0.8) * c(6.64835, 25.80786976, 40.54417323, 72.44665423, 
                             163.6673542, 656.3687191, 16423.22022) +
        (conf[i] == 0.75) * c(4.700876432, 20.3312336, 32.2203623, 57.93630836, 
                              131.443365, 528.4288547, 13232.17423)
      D <- Draw[accall %in% acc]
      # Calculate sample sizes
      n2_2 <- ceiling(N / (sqrt((N - 1) / D) + 1))
      # store data 
      df <- data.frame(
        N = rep(N, length(acc)),
        Confidence = rep(conf[i], length(acc)),
        Precision = acc,
        SampleSize = n2_2
      )
      results <- rbind(results, df)
    }
  }
  
  return(results)
}

